#!/bin/sh
# Заглушка init-скрипта Forkop: проверяет, что podkop-mcp вызывает reload.
# /tmp/forkop-fail-reload заставляет reload упасть — для проверки автоотката.
case "$1" in
    reload|restart|start)
        if [ -f /tmp/forkop-fail-reload ]; then
            echo "forkop: reload rejected by emulator" >&2
            exit 1
        fi
        : > /tmp/forkop-reload
        rm -f /tmp/forkop-stopped
        exit 0
        ;;
    stop)
        : > /tmp/forkop-stopped
        rm -f /tmp/forkop-reload
        exit 0
        ;;
    enable|disable|status)
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
