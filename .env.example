# Пример окружения. Скопируйте в .env или задайте переменные в конфиге MCP-клиента.

# --- Вариант 1: один роутер, SSH-алиас из ~/.ssh/config (рекомендуется) ---
PODKOP_MCP_SSH_CONFIG_HOST=router-home
PODKOP_MCP_SSH_KEY_PATH=C:/Users/<user>/.ssh/router_key
PODKOP_MCP_KNOWN_HOSTS=C:/Users/<user>/.ssh/known_hosts
PODKOP_MCP_HOST_KEY_POLICY=reject
PODKOP_MCP_TARGET_NAME=router

# --- Вариант 2: напрямую ---
# PODKOP_MCP_SSH_HOST=192.168.1.1
# PODKOP_MCP_SSH_PORT=22
# PODKOP_MCP_SSH_USER=root
# PODKOP_MCP_SSH_KEY_PATH=C:/Users/<user>/.ssh/router_key
# PODKOP_MCP_HOST_KEY_POLICY=reject

# --- Вариант 3: несколько роутеров через JSON ---
# PODKOP_MCP_TARGETS={"targets":{"home":{"host":"192.168.1.1","user":"root","key_path":"C:/Users/<user>/.ssh/router_key"},"office":{"ssh_config_host":"router-office"}},"default_target":"home"}

# --- Общие настройки ---
# PODKOP_MCP_READ_ONLY=1
# PODKOP_MCP_BACKUP_DIR=/etc/podkop-mcp/backups
# PODKOP_MCP_BACKUP_KEEP=30
# PODKOP_MCP_COMMAND_TIMEOUT=45
# PODKOP_MCP_MAX_OUTPUT_BYTES=200000
# PODKOP_MCP_LOG_LEVEL=INFO
